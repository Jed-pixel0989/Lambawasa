# Copy this file to .env and replace both passwords before starting the stack.
APP_PORT=8080
DB_PASSWORD=replace-with-a-long-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-root-password

# Optional: set this when the frontend is hosted separately (for example Vercel).
# Use the public URL of this Docker deployment's PHP API, ending in /api.
VITE_API_BASE_URL=

# Optional: configure email-based registration/notifications.
SIA_SMTP_HOST=
SIA_SMTP_PORT=587
SIA_SMTP_USERNAME=
SIA_SMTP_PASSWORD=
SIA_MAIL_FROM=
SIA_MAIL_FROM_NAME=Lambawasa Municipal Water District

# Optional: PayMongo secret key for payment integration.
PAYMONGO_SECRET_KEY=
